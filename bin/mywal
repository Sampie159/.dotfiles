#!/usr/bin/env bash

restart_waybar () {
  pkill -f waybar
  while pgrep -f waybar > /dev/null; do sleep 0.05; done
  waybar &
  echo "resetted waybar"
}

set_wallpaper () {
  awww img "${1}" \
    --transition-fps=60 \
    --transition-step=1 \
    --transition-type=random
}

restart_mako () {
  makoctl reload
}

while getopts ri: flag
do
  case "${flag}" in
    i) wal -i "${OPTARG}"
       if pgrep -f waybar > /dev/null; then
         restart_waybar
       fi

       set_wallpaper "${OPTARG}"

       if pgrep -x awesome > /dev/null; then
         awesome-client 'awesome.restart()' > /dev/null 2>&1
       fi

       restart_mako
       pywalfox update
       ;;
    r) wal -q -i ~/Wallpapers/
        echo "1"
       source ${HOME}/.cache/wal/colors.sh
       echo $wallpaper
       if pgrep -f waybar > /dev/null; then
         restart_waybar
       fi

       set_wallpaper $wallpaper

       if pgrep -x awesome > /dev/null; then
         awesome-client 'awesome.restart()' > /dev/null 2>&1
       fi

       restart_mako
       pywalfox update
       ;;
  esac
done
